{
  "manifest_version": 3,
  "name": "Shopee Voucher Saver & Affiliate Tax",
  "description": "Lưu voucher Shopee, thống kê chi tiêu tài khoản và Sổ tay thuế / Xuất doanh thu Shopee Affiliate (Excel, CSV).",
  "version": "2.0",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://shopee.vn/*",
    "*://*.shopee.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee Voucher Saver & Affiliate Tax",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://affiliate.shopee.vn/payment/*"
      ],
      "js": ["affiliate_content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "tax_report.html",
        "tax_report.js",
        "stats.html",
        "stats.js",
        "icon.png"
      ],
      "matches": [
        "*://shopee.vn/*",
        "*://*.shopee.vn/*"
      ]
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
